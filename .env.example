DATABASE_URL=postgresql+asyncpg://context:context@localhost:5432/context
# Replace both tokens. Allowed project slugs must match projects created through the API.
AUTH_TOKENS={"replace-admin-token":{"developer_id":"admin","role":"admin","projects":["*"]},"replace-agent-token":{"developer_id":"developer-1","role":"writer","projects":["demo"]}}
PLANE_BASE_URL=https://api.plane.so
PLANE_API_VERSION=v1
PLANE_API_KEY=
# Enable only when reports should also be published as Plane comments.
PLANE_SYNC_REPORTS=false
MCP_ALLOWED_HOSTS=["localhost:*","127.0.0.1:*","testserver"]
MCP_ALLOWED_ORIGINS=["http://localhost:*","http://127.0.0.1:*"]

